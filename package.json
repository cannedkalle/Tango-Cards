{
  "name": "kids-play-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "design:sync": "node scripts/sync-design-system.js",
    "build": "npm run design:check && node scripts/build-manifest.js && node scripts/build-prompts.js && next build",
    "start": "next start",
    "serve": "python3 -m http.server 4173",
    "design:check": "node scripts/check-design.js",
    "wild-guess:setup": "node --env-file-if-exists=.env.local scripts/setup-wild-guess.mjs",
    "test:before-the-bulb": "node --test tests/before-the-bulb.test.mjs",
    "wild-guess:test": "node --test tests/wild-guess.test.mjs",
    "test:name-quest": "node --test tests/name-quest.test.mjs",
    "test:marble-battles": "node --test tests/marble-battles.test.mjs",
    "test:animal-outsider": "node --test tests/animal-outsider.test.mjs",
    "test:tango-cards": "node --test tests/tango-cards.test.mjs",
    "wild-guess:audit": "node scripts/audit-wild-guess-subjects.mjs",
    "wild-guess:proposals": "node scripts/export-wild-guess-proposals.mjs",
    "wild-guess:subjects": "node scripts/export-wild-guess-subjects.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
